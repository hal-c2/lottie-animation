#!/usr/bin/env bash
#MISE description="Run check, then load every Lottie JSON headless in Qt's Lottie player (qml6, Qt.labs.lottieqt) and assert it reaches Ready with its frame range; --no-qt runs check only"
#MISE depends=["check"]
#USAGE flag "--no-qt" help="Skip the Qt player load (check still runs)"
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=tools/qt.sh
. "$root/tools/qt.sh"

if [ "${usage_no_qt:-}" = true ]; then
  echo "test: skipped the Qt player load (--no-qt)"
  exit 0
fi
if ! qml="$(find_qml)"; then
  echo "test: qml6 not found: $QT_LOTTIE_HELP; or run 'mise run test --no-qt'" >&2
  exit 1
fi
problem="$(qt_lottie_problem "$qml")"
if [ -n "$problem" ]; then
  echo "test: $problem: $QT_LOTTIE_HELP; or run 'mise run test --no-qt'" >&2
  exit 1
fi

# Captured first, so a failing frames step stops the test instead of leaving a
# short list behind a process substitution.
frames="$(python "$root/tools/lottie_check.py" frames "$root")"
args=()
while IFS="$(printf '\t')" read -r url ip op; do
  [ -n "$url" ] && args+=("$url|$ip|$op")
done <<EOF
$frames
EOF
if [ "${#args[@]}" -eq 0 ]; then
  echo "test: no Lottie JSON files found under version*/" >&2
  exit 1
fi
# Qt's player reads Lottie JSON only, not dotLottie archives; check already
# proved each .lottie holds exactly its sibling .json.
echo "test: loading ${#args[@]} Lottie JSON file(s) in $qml (.lottie files are covered by check: Qt reads only JSON)"
qt_offscreen_env
bounded 60 "$qml" "$root/tools/qt_load.qml" -- "${args[@]}"
